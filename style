body {
  font-family: "Segoe UI", "Roboto", Arial, sans-serif;
  background: linear-gradient(135deg, #f8fafc 0%, #c6f0ff 100%);
  min-height: 100vh;
  margin: 0;
}
.container {
  background: #fff;
  box-shadow: 0 6px 28px 0 rgba(16, 53, 102, 0.1);
  max-width: 480px;
  margin: 36px auto 0 auto;
  border-radius: 18px;
  padding: 32px 20px 24px 20px;
  text-align: center;
}
.main-heading {
  color: #1782cb;
  font-size: 2.1rem;
  margin-bottom: 8px;
}
.sub-heading {
  font-size: 1.1rem;
  color: #797e82;
  margin-bottom: 2rem;
}
.water-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-bottom: 24px;
}
.water-item {
  display: flex;
  align-items: center;
  background: #f2faff;
  border-radius: 12px;
  padding: 15px;
  gap: 18px;
}
.water-item img {
  width: 54px;
  height: 54px;
  object-fit: contain;
  border-radius: 6px;
  background: #fff;
  border: 1px solid #bbe9ff;
  box-shadow: 0 0 6px rgba(24, 183, 222, 0.08);
}
.water-item h2 {
  font-size: 1.07rem;
  color: #232a3d;
  margin: 0 0 3px 0;
}
.water-item .price {
  color: #29a9e2;
  font-weight: bold;
  margin: 0 0 5px 0;
}
.water-item label {
  font-weight: 500;
  color: #636e75;
}
.water-item input[type="number"] {
  width: 42px;
  padding: 4px;
  border: 1px solid #b3e7fb;
  border-radius: 4px;
  margin-left: 6px;
  font-size: 1rem;
}
.total {
  display: flex;
  justify-content: flex-end;
  font-size: 1.2rem;
  margin-bottom: 20px;
  gap: 8px;
  font-weight: 600;
  color: #1584c1;
}
.order-btn {
  padding: 11px 37px;
  font-size: 1.1rem;
  background: #1782cb;
  color: #fff;
  border: none;
  border-radius: 7px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.18s;
  box-shadow: 0px 2px 8px #b7eaff5a;
}
.order-btn:hover {
  background: #11567e;
}
#orderSuccess {
  margin-top: 30px;
}
.hide {
  display: none;
}
@media (max-width: 600px) {
  .container {
    padding: 18px 6px 16px 6px;
    margin-top: 10px;
  }
  .main-heading {
    font-size: 1.3rem;
  }
}
